{
    "manifest_version": 3,
    "name": "YouTube Auto Pause",
    "version": "1.0",
    "description": "Pauses a YouTube video at a set timestamp.",
    "background": {
      "service_worker": "dist/background.js",
      "type": "module"
    },
    "icons": {
    "16": "dist/icon16.png",
    "32": "dist/icon32.png",
    "48": "dist/icon48.png",
    "128": "dist/icon128.png"
  },
    "content_scripts": [
      {
        "matches": ["*://www.youtube.com/watch*"],
        "js": ["dist/content.js"],
        "type": "module"

      }
    ],
    "action": {
      "default_popup": "dist/popup.html"
    },
    "permissions": [
      "storage",
      "activeTab",
      "tabs"
    ],
    "host_permissions": [
      "https://www.youtube.com/*"
    ],
    "web_accessible_resources": [
      {
        "resources": ["assets/*"],
        "matches": ["https://www.youtube.com/*"]
      }
    ]
  }
  